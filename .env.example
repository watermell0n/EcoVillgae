COMPOSE_PROJECT_NAME=ecovillage

POSTGRES_DB=ecovillage
POSTGRES_USER=ecovillage
POSTGRES_PASSWORD=ecovillage_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

BACKEND_PORT=8080
AI_SERVICE_PORT=8000
TEACHER_WEB_PORT=3000
AI_SERVICE_ENABLED=true

# 로컬 전용 기본값입니다. 운영에서는 충분히 긴 별도 값을 사용합니다.
ECOVILLAGE_AI_ENVIRONMENT=local
ECOVILLAGE_AI_INTERNAL_SERVICE_TOKEN=local-development-token
ECOVILLAGE_AI_INTERNAL_SERVICE_SCOPES=ai:generate:balancing,ai:generate:teacher-chat,ai:generate:economic-event,ai:generate:quiz-draft,ai:generate:investment-company
ECOVILLAGE_AI_PROVIDER=OPENAI
# 값을 채우면 아래 공급자별 모델 지정을 덮어쓴다. FAKE는 비어 있어도 deterministic-v1로 동작한다.
ECOVILLAGE_AI_MODEL_ID=
ECOVILLAGE_AI_BEDROCK_MODEL_ID=
ECOVILLAGE_AI_OPENAI_ENABLED=true
ECOVILLAGE_AI_OPENAI_MODEL_ID=gpt-5.4
# 기능별 선택 형식: FAKE:모델, BEDROCK:모델, OPENAI:모델
ECOVILLAGE_AI_ROUTE_BALANCING=
ECOVILLAGE_AI_ROUTE_TEACHER_CHAT=
ECOVILLAGE_AI_ROUTE_ECONOMIC_EVENT=
ECOVILLAGE_AI_ROUTE_QUIZ_DRAFT=OPENAI:gpt-5.4
# 실제 OpenAI는 보통 5초 안에 오지만 꼬리 지연이 10초를 넘습니다.
# 교사용 챗봇의 문서상 응답 제한(20초)에 맞춥니다.
ECOVILLAGE_AI_PROVIDER_TIMEOUT_SECONDS=20
# 백엔드는 공급자 타임아웃보다 늦게 끊어야 504를 그대로 받을 수 있습니다.
AI_SERVICE_READ_TIMEOUT=25s
AI_SERVICE_TOTAL_TIMEOUT=30s
ECOVILLAGE_AI_MAX_OUTPUT_TOKENS=4096
ECOVILLAGE_AI_MINIMUM_DEADLINE_REMAINING_SECONDS=0.05
ECOVILLAGE_AI_DOCS_ENABLED=true

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=14d
AUTH_JWT_SECRET=local-development-jwt-secret-change-before-deploy
AUTH_TOKEN_PEPPER=local-development-token-pepper-change-before-deploy
AUTH_LOGIN_ATTEMPT_LIMIT=20
AUTH_LOGIN_ATTEMPT_WINDOW=1m
AUTH_REFRESH_COOKIE_NAME=ecovillage_teacher_refresh
AUTH_REFRESH_COOKIE_SECURE=false
# 교사 웹은 3000, 학생 Expo 웹은 8081 포트를 사용합니다.
# localhost와 127.0.0.1은 브라우저에서 서로 다른 출처이므로 둘 다 허용합니다.
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# 교사 웹이 Authorization Code + PKCE로 받은 OIDC ID 토큰을 백엔드가 검증합니다.
# 운영에서는 아래 네 값을 실제 학교 계정 제공자 설정으로 교체합니다.
TEACHER_OIDC_ENABLED=false
TEACHER_OIDC_ISSUER=
TEACHER_OIDC_JWK_SET_URI=
TEACHER_OIDC_CLIENT_ID=
TEACHER_OIDC_NAME_CLAIM=name

AWS_REGION=ap-northeast-2
AWS_ENDPOINT_URL=
S3_BUCKET=
SQS_QUEUE_URL=
# OpenAI 호환 자격증명. 비워두면 공식 엔드포인트를 쓰고, GMS 프록시를 쓸 때만 base URL을 채운다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# 실제 태블릿에서는 localhost 대신 개발 PC의 같은 네트워크 IP를 사용합니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 교사 OIDC 화면이 연결되기 전 로컬 계약 테스트에서만 사용합니다.
NEXT_PUBLIC_SCHOOL_ID=
NEXT_PUBLIC_CLASSROOM_ID=
