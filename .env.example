COMPOSE_PROJECT_NAME=ecovillage

POSTGRES_DB=ecovillage
POSTGRES_USER=ecovillage
POSTGRES_PASSWORD=ecovillage_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

BACKEND_PORT=8080
AI_SERVICE_PORT=8000
TEACHER_WEB_PORT=3000

# 로컬 전용 기본값입니다. 운영에서는 충분히 긴 별도 값을 사용합니다.
ECOVILLAGE_AI_ENVIRONMENT=local
ECOVILLAGE_AI_INTERNAL_SERVICE_TOKEN=local-development-token
ECOVILLAGE_AI_INTERNAL_SERVICE_SCOPES=ai:generate:balancing,ai:generate:teacher-chat,ai:generate:economic-event,ai:generate:quiz-draft
ECOVILLAGE_AI_PROVIDER=FAKE
ECOVILLAGE_AI_MODEL_ID=deterministic-v1
ECOVILLAGE_AI_BEDROCK_MODEL_ID=
ECOVILLAGE_AI_OPENAI_ENABLED=false
ECOVILLAGE_AI_OPENAI_MODEL_ID=
# 기능별 선택 형식: FAKE:모델, BEDROCK:모델, OPENAI:모델
ECOVILLAGE_AI_ROUTE_BALANCING=
ECOVILLAGE_AI_ROUTE_TEACHER_CHAT=
ECOVILLAGE_AI_ROUTE_ECONOMIC_EVENT=
ECOVILLAGE_AI_ROUTE_QUIZ_DRAFT=
ECOVILLAGE_AI_PROVIDER_TIMEOUT_SECONDS=10
ECOVILLAGE_AI_MAX_OUTPUT_TOKENS=4096
ECOVILLAGE_AI_MINIMUM_DEADLINE_REMAINING_SECONDS=0.05
ECOVILLAGE_AI_DOCS_ENABLED=true

AWS_REGION=ap-northeast-2
AWS_ENDPOINT_URL=
S3_BUCKET=
SQS_QUEUE_URL=
OPENAI_API_KEY=

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# 실제 태블릿에서는 localhost 대신 개발 PC의 같은 네트워크 IP를 사용합니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
