# 운영 도메인
DOMAIN=i15b201.p.ssafy.io

# PostgreSQL: 외부 포트로 공개하지 않고 Compose 내부 네트워크에서만 사용
POSTGRES_DB=ecovillage
POSTGRES_USER=ecovillage
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_64_HEX

# 인증 및 내부 서비스 통신용 비밀값
AUTH_JWT_SECRET=CHANGE_ME_RANDOM_96_HEX
AUTH_TOKEN_PEPPER=CHANGE_ME_RANDOM_96_HEX
ECOVILLAGE_AI_INTERNAL_SERVICE_TOKEN=CHANGE_ME_RANDOM_96_HEX

# AI 공급자
ECOVILLAGE_AI_PROVIDER=OPENAI
ECOVILLAGE_AI_MODEL_ID=
ECOVILLAGE_AI_OPENAI_ENABLED=true
ECOVILLAGE_AI_OPENAI_MODEL_ID=gpt-5.4
OPENAI_API_KEY=CHANGE_ME_OPENAI_PROJECT_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# 선택: 외부 교사 OIDC를 사용할 때만 설정
TEACHER_OIDC_ENABLED=false
TEACHER_OIDC_ISSUER=
TEACHER_OIDC_JWK_SET_URI=
TEACHER_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUTHORIZATION_URL=
NEXT_PUBLIC_OIDC_TOKEN_URL=
NEXT_PUBLIC_OIDC_CLIENT_ID=
